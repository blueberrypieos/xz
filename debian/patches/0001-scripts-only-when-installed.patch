Description: Configure the scripts only when they are installed
 The package installs liblzma and xz, not xzdiff, xzgrep, xzless or xzmore.
Author: The Blueberry Pie OS Authors
Forwarded: not-needed
Last-Update: 2026-11-03

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -2370,6 +2370,7 @@ xzdiff, xzgrep, xzmore, xzless, and thei
     set(xz "xz")
     set(POSIX_SHELL "${XZ_POSIX_SHELL}")
 
+    if(ENABLE_SCRIPTS)
     foreach(S xzdiff xzgrep xzmore xzless)
         configure_file("src/scripts/${S}.in" "${S}"
                @ONLY
@@ -2384,6 +2385,7 @@ xzdiff, xzgrep, xzmore, xzless, and thei
                     COMPONENT scripts_Runtime)
         endif()
     endforeach()
+    endif()
 
     unset(xz)
     unset(POSIX_SHELL)
